# Absolute joint1..joint6 targets in radians.
float64[6] positions_rad

# Multiplier in (0, 1] applied to the server's configured per-joint velocity limit.
float64 speed_scale

# Maximum execution time in seconds. Zero requests the server default; negative is invalid.
float64 timeout_sec

# Positive per-goal execution gate. False performs validation/preview only.
bool execute
---
duojin_interfaces/ArmMotionStatus status
float64[6] final_positions_rad
# False means final_positions_rad and max_position_error_rad are placeholders.
bool final_positions_valid
float64 max_position_error_rad
---
uint8 VALIDATING=0
uint8 PUBLISHING=1
uint8 WAITING_FOR_GOAL=2
uint8 HOLDING=3
uint8 PREVIEW=4

uint8 phase
float64[6] current_positions_rad
float64 max_position_error_rad
float64 elapsed_sec
