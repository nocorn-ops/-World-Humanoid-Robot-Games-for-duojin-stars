# Absolute end-effector target. Position is expressed in target_pose.header.frame_id.
geometry_msgs/PoseStamped target_pose

# Version 1 accepts only true and preserves the first fresh orientation read during validation.
bool keep_current_orientation

# Maximum execution time in seconds. Zero requests the server default; negative is invalid.
float64 timeout_sec

# Positive per-goal execution gate. False performs validation/preview only.
bool execute
---
duojin_interfaces/ArmMotionStatus status
geometry_msgs/PoseStamped final_pose
# False means final_pose and both error fields are placeholders and must not be used.
bool final_pose_valid
float64 position_error_m
float64 orientation_error_rad
---
uint8 VALIDATING=0
uint8 PUBLISHING=1
uint8 WAITING_FOR_GOAL=2
uint8 HOLDING=3
uint8 PREVIEW=4

uint8 phase
geometry_msgs/PoseStamped current_pose
float64 position_error_m
float64 orientation_error_rad
float64 elapsed_sec
